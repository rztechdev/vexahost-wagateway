# =============================================================================
# Flustra WA Gateway — template environment (sisi engine Node.js)
#
# ENGINE_TOKEN dan ENGINE_HMAC_SECRET harus SAMA PERSIS dengan .env Laravel.
# Kalau berbeda, semua permintaan Laravel ditolak dan semua callback engine
# ditolak — gejalanya sesi mentok di "connecting" tanpa penjelasan.
# =============================================================================

PORT=3100

# Lokal: 127.0.0.1 supaya tidak terbuka ke jaringan.
# Coolify: 0.0.0.0 agar bisa dijangkau container Laravel.
HOST=127.0.0.1

ENGINE_TOKEN=
ENGINE_HMAC_SECRET=

# URL Laravel dari sudut pandang container engine.
# Lokal: http://127.0.0.1:8070
# Coolify: nama service internal Laravel, mis. http://flustra-wa:80
LARAVEL_URL=http://127.0.0.1:8070

# Lokasi kredensial sesi WhatsApp.
# Lokal: folder biasa. Coolify: HARUS menunjuk ke persistent volume,
# karena inilah yang membuat sesi selamat dari deploy ulang.
WA_DATA_PATH=./.wwebjs_auth

# Interval backup sesi ke Laravel (minimum 60000 ms).
WA_BACKUP_INTERVAL_MS=300000

# Jeda acak antar pesan keluar per sesi (anti-ban).
WA_MIN_DELAY_MS=3000
WA_MAX_DELAY_MS=8000

# Tiap sesi menjalankan satu Chromium (±300–500 MB RAM).
# Sesuaikan dengan RAM container: 10 sesi butuh sekitar 4–5 GB.
WA_MAX_SESSIONS=3

LOG_LEVEL=debug

# Nixpacks memakai Node 18 (sudah EOL) kalau tidak diberi tahu. Engine butuh
# Node 20 — lihat "engines" di engine/package.json.
NIXPACKS_NODE_VERSION=20
