# =============================================================================
# ENGINE — PRODUCTION
# Resource Coolify: flustra-wa-engine  (tanpa domain publik)
#
# ENGINE_TOKEN dan ENGINE_HMAC_SECRET harus SAMA PERSIS dengan .env.production
# milik Laravel, dan BERBEDA dari tahap dev maupun staging.
#
# PERIKSA SEBELUM DEPLOY:
#   - Persistent volume sudah ter-mount ke /data. Tanpa ini, seluruh nomor
#     harus di-scan ulang setiap deploy — persis masalah yang gateway ini
#     dibuat untuk menyelesaikannya.
#   - Resource RAM cukup: WA_MAX_SESSIONS × ~500 MB, plus ruang lega.
# =============================================================================

PORT=3100
HOST=0.0.0.0

ENGINE_TOKEN=
ENGINE_HMAC_SECRET=

LARAVEL_URL=http://flustra-wa:80

WA_DATA_PATH=/data/.wwebjs_auth

# Cadangan dikirim ke Laravel tiap 5 menit. Semakin sering, semakin kecil
# kehilangan bila volume ikut hilang — tapi semakin sering pula zip sesi
# dimampatkan dan diunggah. Minimum yang diizinkan library: 60000.
WA_BACKUP_INTERVAL_MS=300000

# JANGAN diturunkan. Jeda inilah yang menjaga nomor tidak diblokir.
WA_MIN_DELAY_MS=3000
WA_MAX_DELAY_MS=8000

# Container 4 GB RAM. Engine akan menolak sesi ke-11 alih-alih kehabisan
# memori dan restart berulang.
WA_MAX_SESSIONS=10

LOG_LEVEL=info
