# =============================================================================
# ENGINE — STAGING
# Resource Coolify: flustra-wa-engine-staging  (tanpa domain publik)
#
# ENGINE_TOKEN dan ENGINE_HMAC_SECRET harus SAMA PERSIS dengan .env.staging
# milik Laravel, dan BERBEDA dari tahap dev maupun production.
# =============================================================================

PORT=3100
HOST=0.0.0.0

ENGINE_TOKEN=
ENGINE_HMAC_SECRET=

LARAVEL_URL=http://flustra-wa-staging:80

WA_DATA_PATH=/data/.wwebjs_auth
WA_BACKUP_INTERVAL_MS=300000

# Sama dengan production — inilah yang membuat staging berguna sebagai latihan.
WA_MIN_DELAY_MS=3000
WA_MAX_DELAY_MS=8000

# Container staging 2 GB RAM.
WA_MAX_SESSIONS=3

LOG_LEVEL=info
