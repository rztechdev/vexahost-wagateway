# =============================================================================
# ENGINE — DEVELOPMENT
# Resource Coolify: flustra-wa-engine-dev  (tanpa domain publik)
#
# ENGINE_TOKEN dan ENGINE_HMAC_SECRET harus SAMA PERSIS dengan
# .env.development milik Laravel. Kalau berbeda, gejalanya: semua permintaan
# Laravel ditolak dan semua callback engine ditolak — sesi mentok "connecting"
# tanpa penjelasan.
# =============================================================================

PORT=3100
HOST=0.0.0.0

ENGINE_TOKEN=
ENGINE_HMAC_SECRET=

# Nama service internal Laravel di tahap ini.
LARAVEL_URL=http://flustra-wa-dev:80

# WAJIB menunjuk ke persistent volume yang di-mount di /data.
# Tanpa ini, sesi hilang setiap deploy.
WA_DATA_PATH=/data/.wwebjs_auth

WA_BACKUP_INTERVAL_MS=300000

# Dipendekkan agar pengujian tidak berlarut-larut. Aman karena nomornya nomor
# uji coba. JANGAN disalin ke staging atau production.
WA_MIN_DELAY_MS=1000
WA_MAX_DELAY_MS=2000

# Container dev cukup 1 GB RAM. Satu sesi ≈ 300–500 MB.
WA_MAX_SESSIONS=2

LOG_LEVEL=debug
