# =============================================================================
# PRODUCTION — https://wa.flustra.id
#
# Branch: main
# Resource Coolify: flustra-wa, flustra-wa-engine, flustra-wa-worker
#
# Melayani pelanggan sungguhan. Perubahan di sini hanya setelah lolos uji di
# development dan staging (daftar periksa promosi ada di docs/ENVIRONMENT.md).
#
# PERIKSA SEBELUM DEPLOY:
#   - APP_DEBUG harus false. Kalau true, halaman error akan menampilkan seluruh
#     isi environment ini — termasuk password database dan secret HMAC.
#   - ENGINE_TOKEN dan ENGINE_HMAC_SECRET harus berbeda dari dev/staging.
#   - Persistent volume engine sudah ter-mount ke /data.
# =============================================================================

APP_NAME="Flustra WA Gateway"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://wa.flustra.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- Database ----------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=fdojna28elnxldlp5wt0fi8r
DB_PORT=3306
DB_DATABASE=db_flustra-wa
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_FROM_ADDRESS="no-reply@flustra.id"
MAIL_FROM_NAME="${APP_NAME}"

# --- Engine ------------------------------------------------------------------
ENGINE_URL=http://flustra-wa-engine:3100

# Buat dengan: openssl rand -hex 32
# Sama persis dengan milik engine production, BERBEDA dari dev dan staging.
ENGINE_TOKEN=
ENGINE_HMAC_SECRET=

ENGINE_TIMEOUT=15
ENGINE_CONNECT_TIMEOUT=5

# --- Sesi platform -----------------------------------------------------------
# Nomor resmi Flustra. Dipakai untuk OTP, undangan anggota, notifikasi billing,
# dan balasan tiket — pesan atas nama Flustra, bukan atas nama tenant.
PLATFORM_SESSION_ID=
QR_TTL_SECONDS=90

# --- Batas tenant ------------------------------------------------------------
TENANT_DEFAULT_MAX_SESSIONS=1
TENANT_DEFAULT_MONTHLY_QUOTA=1000
TENANT_DEFAULT_RATE_LIMIT=60

# --- Jeda antar pesan --------------------------------------------------------
# JANGAN diturunkan. Mengirim beruntun tanpa jeda adalah pola paling khas robot
# dan cara paling cepat membuat nomor diblokir WhatsApp.
WA_MIN_DELAY_MS=3000
WA_MAX_DELAY_MS=8000

# --- OTP ---------------------------------------------------------------------
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60
OTP_MAX_PER_PHONE_PER_DAY=10

# --- Retensi -----------------------------------------------------------------
RETENTION_MESSAGES_DAYS=90
RETENTION_WEBHOOK_DAYS=30

FONNTE_TOKEN=

VITE_APP_NAME="${APP_NAME}"
