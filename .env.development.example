# =============================================================================
# DEVELOPMENT — https://wa-dev.flustra.tech
#
# Branch: dev
# Resource Coolify: flustra-wa-dev, flustra-wa-engine-dev, flustra-wa-worker-dev
#
# Tempat mencoba hal baru. Boleh dirusak.
# Salin isi file ini ke Environment Variables resource `flustra-wa-dev`,
# lalu isi baris yang masih kosong.
#
# JANGAN pernah memakai nomor WhatsApp produksi di tahap ini — satu nomor
# hanya bisa tertaut ke satu sesi aktif, jadi men-scan di sini akan memutus
# sesi produksinya dan menghentikan notifikasi pelanggan.
# =============================================================================

APP_NAME="Flustra WA Gateway (Dev)"
APP_ENV=development
APP_KEY=
APP_DEBUG=true
APP_URL=https://wa-dev.flustra.tech

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database ----------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=fdojna28elnxldlp5wt0fi8r
DB_PORT=3306
DB_DATABASE=db_flustra-wa_dev
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@flustra.id"
MAIL_FROM_NAME="${APP_NAME}"

# --- Engine ------------------------------------------------------------------
# Nama service internal Coolify, bukan localhost.
ENGINE_URL=http://flustra-wa-engine-dev:3100

# Buat dengan: openssl rand -hex 32
# Nilai HARUS sama persis dengan milik engine di tahap ini,
# dan HARUS berbeda dari tahap staging maupun production.
ENGINE_TOKEN=
ENGINE_HMAC_SECRET=

ENGINE_TIMEOUT=15
ENGINE_CONNECT_TIMEOUT=5

# --- Sesi platform -----------------------------------------------------------
# Diisi dari keluaran:
#   php artisan gateway:setup-tenant "Flustra Internal" --internal --session="Platform" --platform
PLATFORM_SESSION_ID=
QR_TTL_SECONDS=90

# --- Batas tenant ------------------------------------------------------------
# Dilonggarkan supaya pengujian tidak mentok kuota.
TENANT_DEFAULT_MAX_SESSIONS=3
TENANT_DEFAULT_MONTHLY_QUOTA=100000
TENANT_DEFAULT_RATE_LIMIT=300

# --- Jeda antar pesan --------------------------------------------------------
# Dipendekkan agar pengujian tidak berlarut-larut. Aman di sini karena nomornya
# nomor uji coba. JANGAN disalin ke staging atau production.
WA_MIN_DELAY_MS=1000
WA_MAX_DELAY_MS=2000

# --- OTP ---------------------------------------------------------------------
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=30
OTP_MAX_PER_PHONE_PER_DAY=50

# --- Retensi -----------------------------------------------------------------
# Pendek — data uji tidak perlu disimpan lama.
RETENTION_MESSAGES_DAYS=7
RETENTION_WEBHOOK_DAYS=7

FONNTE_TOKEN=

VITE_APP_NAME="${APP_NAME}"
