# =============================================================================
# Flustra WA Gateway — template environment (sisi Laravel)
#
# Salin ke .env lalu sesuaikan. Untuk nilai per tahap (development, staging,
# production) lihat docs/ENVIRONMENT.md — di Coolify tiap tahap adalah resource
# terpisah dengan environment variables-nya sendiri.
#
# JANGAN pernah commit file .env yang sudah terisi.
# =============================================================================

APP_NAME="Flustra WA Gateway"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8070

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database ----------------------------------------------------------------
# Lokal boleh sqlite supaya tidak perlu menjalankan MySQL.
# Dev/staging/production memakai MySQL bersama di Coolify.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=
# DB_PORT=3306
# DB_DATABASE=db_flustra-wa
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@flustra.id"
MAIL_FROM_NAME="${APP_NAME}"

# --- Engine Node.js (whatsapp-web.js) ----------------------------------------
# Lokal: http://127.0.0.1:3100
# Coolify: nama service internal engine, mis. http://flustra-wa-engine:3100
ENGINE_URL=http://127.0.0.1:3100

# Token statis yang dikirim Laravel sebagai header X-Engine-Token.
ENGINE_TOKEN=

# Secret HMAC untuk menandatangani callback engine -> Laravel.
# WAJIB berbeda dari ENGINE_TOKEN, dan harus sama persis dengan milik engine.
ENGINE_HMAC_SECRET=

ENGINE_TIMEOUT=15
ENGINE_CONNECT_TIMEOUT=5

# --- Sesi platform -----------------------------------------------------------
# ULID sesi milik Flustra sendiri (kind=platform), dipakai untuk OTP dan
# notifikasi atas nama Flustra. Diisi dari keluaran:
#   php artisan gateway:setup-tenant "Flustra Internal" --internal --session="Platform" --platform
PLATFORM_SESSION_ID=

# Masa berlaku QR di dashboard. Jangan di bawah 60 detik — whatsapp-web.js
# menerbitkan QR baru dengan jeda tidak tetap hingga ~60 detik, dan nilai yang
# lebih pendek membuat modal QR berkedip kosong di antara dua QR.
QR_TTL_SECONDS=90

# --- Batas bawaan tenant baru ------------------------------------------------
TENANT_DEFAULT_MAX_SESSIONS=1
TENANT_DEFAULT_MONTHLY_QUOTA=1000
TENANT_DEFAULT_RATE_LIMIT=60

# --- Jeda antar pesan (anti-ban) ---------------------------------------------
WA_MIN_DELAY_MS=3000
WA_MAX_DELAY_MS=8000

# --- OTP ---------------------------------------------------------------------
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60
OTP_MAX_PER_PHONE_PER_DAY=10

# --- Retensi data ------------------------------------------------------------
RETENTION_MESSAGES_DAYS=90
RETENTION_WEBHOOK_DAYS=30

# --- Provider berbayar (opsional) --------------------------------------------
FONNTE_TOKEN=

VITE_APP_NAME="${APP_NAME}"
