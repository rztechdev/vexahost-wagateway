# =============================================================================
# STAGING — https://wa-staging.flustra.tech
#
# Branch: staging
# Resource Coolify: flustra-wa-staging, flustra-wa-engine-staging,
#                   flustra-wa-worker-staging
#
# Latihan sebelum produksi. Nilai di sini sengaja dibuat SEMIRIP MUNGKIN dengan
# produksi — kalau staging dilonggarkan, ia berhenti berfungsi sebagai latihan
# dan masalah baru ketahuan setelah menyentuh pelanggan sungguhan.
#
# Perbedaan dari production hanya: domain, database, nama service engine,
# tingkat log, dan masa retensi. Selebihnya identik.
# =============================================================================

APP_NAME="Flustra WA Gateway (Staging)"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://wa-staging.flustra.tech

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# --- Database ----------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=fdojna28elnxldlp5wt0fi8r
DB_PORT=3306
DB_DATABASE=db_flustra-wa_staging
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_FROM_ADDRESS="no-reply@flustra.id"
MAIL_FROM_NAME="${APP_NAME}"

# --- Engine ------------------------------------------------------------------
ENGINE_URL=http://flustra-wa-engine-staging:3100

# Buat dengan: openssl rand -hex 32
# Sama persis dengan milik engine staging, BERBEDA dari dev dan production.
ENGINE_TOKEN=
ENGINE_HMAC_SECRET=

ENGINE_TIMEOUT=15
ENGINE_CONNECT_TIMEOUT=5

# --- Sesi platform -----------------------------------------------------------
PLATFORM_SESSION_ID=
QR_TTL_SECONDS=90

# --- Batas tenant ------------------------------------------------------------
# Sama dengan production.
TENANT_DEFAULT_MAX_SESSIONS=1
TENANT_DEFAULT_MONTHLY_QUOTA=1000
TENANT_DEFAULT_RATE_LIMIT=60

# --- Jeda antar pesan --------------------------------------------------------
# WAJIB sama dengan production. Jeda inilah yang menentukan berapa lama sebuah
# broadcast berjalan; kalau staging lebih cepat, hasil ujinya menyesatkan.
WA_MIN_DELAY_MS=3000
WA_MAX_DELAY_MS=8000

# --- OTP ---------------------------------------------------------------------
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60
OTP_MAX_PER_PHONE_PER_DAY=10

# --- Retensi -----------------------------------------------------------------
RETENTION_MESSAGES_DAYS=30
RETENTION_WEBHOOK_DAYS=14

FONNTE_TOKEN=

VITE_APP_NAME="${APP_NAME}"
